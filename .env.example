# Copy to .env (git-ignored) to run the paid live checks. Never put a real key in this file.
# Create a key at https://openrouter.ai/settings/keys and give it a small credit limit.
XENIUR_LIVE_KEY=
# A priced text model ID from OpenRouter's catalogue, e.g. google/gemini-2.5-flash-lite
XENIUR_LIVE_MODEL=
# Optional: a fixed-price image model for one illustration
XENIUR_LIVE_IMAGE_MODEL=
# Hard cap for one verification run, in USD (above 0, at most 10)
XENIUR_LIVE_MAX_USD=0.25
