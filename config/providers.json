{
  "$comment": [
    "Local tools remain available. Live AI uses OpenRouter; video and 3D generation are deferred."
  ],
  "brain": {
    "default": "mock",
    "escalateAfterFailures": 2,
    "providers": {
      "mock": {
        "enabled": true,
        "kind": "deterministic"
      }
    },
    "$comment": [
      "Ordinary local commands use the deterministic planner. All live language and image work uses the OpenRouter connection."
    ]
  },
  "capabilities": {
    "image": {
      "order": [
        "local.sharp"
      ]
    },
    "video": {
      "order": [
        "local.blender",
        "local.ffmpeg"
      ]
    },
    "to3D": {
      "order": [
        "local.blender"
      ]
    },
    "code": {
      "order": [
        "local.template"
      ]
    },
    "browser": {
      "order": []
    },
    "transform": {
      "order": [
        "local.import",
        "local.sharp",
        "local.ffmpeg",
        "local.blender"
      ]
    },
    "export": {
      "order": [
        "local.blender",
        "local.ffmpeg",
        "local.sharp"
      ]
    }
  },
  "providers": {
    "local.sharp": {
      "enabled": true,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      }
    },
    "local.ffmpeg": {
      "enabled": true,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      },
      "binary": "/opt/homebrew/bin/ffmpeg"
    },
    "local.blender": {
      "enabled": true,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      },
      "binary": "/Applications/Blender.app/Contents/MacOS/Blender",
      "worker": "blender/xeniur_worker.py"
    },
    "local.template": {
      "enabled": true,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      }
    },
    "local.docker": {
      "enabled": false,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      },
      "unavailableReason": "docker not found"
    },
    "local.import": {
      "enabled": true,
      "kind": "deterministic",
      "cost": {
        "usd": 0
      }
    }
  },
  "budget": {
    "$comment": "Hard stops. The router refuses a generative call that would exceed these.",
    "perActionUsdMax": 1.0,
    "perTaskUsdMax": 5.0,
    "totalUsdMax": 100.0
  }
}
