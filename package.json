{
  "name": "xeniur",
  "private": true,
  "version": "0.1.0",
  "description": "A desktop workspace for projects, sources, decisions and useful AI-assisted work.",
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "engines": {
    "node": ">=22.14.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-abi.mjs electron && electron-vite dev -c apps/desktop/electron.vite.config.ts",
    "build": "node scripts/ensure-abi.mjs electron && electron-vite build -c apps/desktop/electron.vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/ensure-abi.mjs node && vitest run",
    "test:watch": "node scripts/ensure-abi.mjs node && vitest",
    "e2e:loop": "node scripts/ensure-abi.mjs node && tsx scripts/e2e-loop.ts",
    "start": "node scripts/ensure-abi.mjs electron && electron-vite preview -c apps/desktop/electron.vite.config.ts",
    "rebuild:electron": "node scripts/ensure-abi.mjs electron",
    "rebuild:node": "node scripts/ensure-abi.mjs node",
    "seed:demo": "node scripts/ensure-abi.mjs node && tsx scripts/seed-demo.ts",
    "preview:world": "node scripts/ensure-abi.mjs node && tsx scripts/preview-world.tsx",
    "preview:web": "vite --config scripts/preview-web.config.ts",
    "demo:asset": "node scripts/ensure-abi.mjs node && tsx scripts/demo-asset.ts",
    "demo:revision": "node scripts/ensure-abi.mjs node && tsx scripts/demo-revision.ts",
    "demo:research": "node scripts/ensure-abi.mjs node && tsx scripts/demo-research.ts",
    "demo:visual": "node scripts/ensure-abi.mjs node && tsx scripts/demo-visual.tsx",
    "demo:sense": "node scripts/ensure-abi.mjs node && tsx scripts/demo-sense.ts",
    "demo:work": "node scripts/ensure-abi.mjs node && tsx scripts/demo-work.ts",
    "demo:arena": "node scripts/ensure-abi.mjs node && tsx scripts/demo-arena.ts",
    "demo:guided": "node scripts/ensure-abi.mjs node && tsx scripts/demo-guided.ts",
    "demo:browser": "node scripts/ensure-abi.mjs node && tsx scripts/demo-browser.ts",
    "preview:ui": "node scripts/ensure-abi.mjs node && tsx scripts/preview-ui.tsx",
    "icons": "node scripts/make-icons.mjs",
    "package": "npm run build && npm run icons && electron-builder --config electron-builder.cjs --publish never",
    "package:dir": "npm run icons && electron-builder --config electron-builder.cjs --dir --publish never",
    "verify:live": "node scripts/ensure-abi.mjs node && node --import tsx scripts/verify-openrouter-live.ts",
    "verify:browser": "node scripts/check-browser-desktop.mjs",
    "verify:workflow": "node scripts/check-workflow-desktop.mjs",
    "verify:export": "node scripts/check-export-desktop.mjs"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.5.6",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@napi-rs/canvas": "0.1.100",
    "@react-three/fiber": "^8.17.10",
    "@tesseract.js-data/eng": "^1.0.0",
    "better-sqlite3": "^13.0.3",
    "clsx": "^2.1.1",
    "fflate": "^0.8.3",
    "framer-motion": "^13.2.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.44.0",
    "parse5": "^8.0.1",
    "pdfjs-dist": "^4.10.38",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "tesseract.js": "^7.0.0",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  },
  "license": "MIT",
  "author": "XENIUR contributors"
}
