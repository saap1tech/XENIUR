{
  "name": "xeniur",
  "private": true,
  "version": "0.1.0",
  "description": "XENIUR — a universal visual computing environment. Intent → Object → Manipulate → Transform → Act → Outcome.",
  "type": "module",
  "main": "apps/desktop/out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node scripts/ensure-abi.mjs electron && electron-vite dev -c apps/desktop/electron.vite.config.ts",
    "build": "node scripts/ensure-abi.mjs electron && electron-vite build -c apps/desktop/electron.vite.config.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "node scripts/ensure-abi.mjs node && vitest run",
    "test:watch": "node scripts/ensure-abi.mjs node && vitest",
    "e2e:loop": "node scripts/ensure-abi.mjs node && tsx scripts/e2e-loop.ts",
    "start": "node scripts/ensure-abi.mjs electron && electron-vite preview -c apps/desktop/electron.vite.config.ts",
    "rebuild:electron": "node scripts/ensure-abi.mjs electron",
    "rebuild:node": "node scripts/ensure-abi.mjs node",
    "seed:demo": "node scripts/ensure-abi.mjs node && tsx scripts/seed-demo.ts",
    "preview:world": "node scripts/ensure-abi.mjs node && tsx scripts/preview-world.tsx",
    "demo:asset": "node scripts/ensure-abi.mjs node && tsx scripts/demo-asset.ts",
    "demo:revision": "node scripts/ensure-abi.mjs node && tsx scripts/demo-revision.ts",
    "demo:visual": "node scripts/ensure-abi.mjs node && tsx scripts/demo-visual.tsx",
    "demo:sense": "node scripts/ensure-abi.mjs node && tsx scripts/demo-sense.ts",
    "preview:ui": "node scripts/ensure-abi.mjs node && tsx scripts/preview-ui.tsx"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.0",
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.170.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.5.6",
    "electron": "^33.2.0",
    "electron-vite": "^2.3.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@react-three/fiber": "^8.17.10",
    "better-sqlite3": "^11.6.0",
    "clsx": "^2.1.1",
    "framer-motion": "^13.2.0",
    "ipaddr.js": "^2.5.0",
    "lucide-react": "^1.44.0",
    "parse5": "^8.0.1",
    "playwright": "^1.49.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "sharp": "^0.35.4",
    "tailwind-merge": "^3.6.0",
    "three": "^0.170.0",
    "zod": "^3.23.8"
  }
}
